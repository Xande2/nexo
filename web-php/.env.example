# Export these variables in the shell; PHP does not automatically load .env files.
# Absolute path, outside web-php/public. Parent directory must already exist.
# NEXO_DB_PATH=/absolute/path/to/nexo.sqlite
NEXO_CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# php web-php/database/init.php
# php -S 127.0.0.1:8000 -t web-php/public web-php/public/router.php
